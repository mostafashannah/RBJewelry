# ─── APP ──────────────────────────────────────────────────────────────────────
# Public base URL this app is deployed at — used to build OAuth redirect and
# webhook registration URLs (Shopify). Update when moving to a new domain.
APP_URL="https://rbjewelry.store"

# ─── DATABASE ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rbjewelry"

# ─── NEXT.JS AUTH ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
DASHBOARD_USERNAME="admin"
DASHBOARD_PASSWORD="changeme"

# ─── ANTHROPIC / CLAUDE ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── SHOPIFY ADMIN API ────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_API_ACCESS_TOKEN="shpat_..."
SHOPIFY_ADMIN_API_VERSION="2024-04"
SHOPIFY_WEBHOOK_SECRET=""

# ─── SHOPIFY STOREFRONT API ───────────────────────────────────────────────────
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN="public_..."
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# ─── META / FACEBOOK / INSTAGRAM ─────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=""
META_WEBHOOK_VERIFY_TOKEN="choose-a-random-secret-string"

# ─── WHATSAPP BUSINESS ────────────────────────────────────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=""

# ─── SOCIALFLOW RELAY (external Meta app) ────────────────────────────────────
SOCIALFLOW_API_KEY=""
SOCIALFLOW_CLIENT_ID=""
SOCIALFLOW_REPLY_URL="https://socialflow.admepro.com/external-bot-reply.php"

# ─── META ADS MANAGER ────────────────────────────────────────────────────────
META_AD_ACCOUNT_ID="act_..."
META_USER_ACCESS_TOKEN=""

# ─── GOOGLE SHEETS ────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEETS_STOCK_ID=""
GOOGLE_SHEETS_FINANCE_ID=""

# ─── WEB PUSH (PWA NOTIFICATIONS) ────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@rbjewelry.co"
